# diagram-app: no Sota secret or private key is required.

# --- local development ---
# The port is pinned to the manifest's environments.local overlay so `sota dev`
# and the process cannot drift.
PORT=8787

# --- hosting (staging / production) ---
# Set NODE_ENV=production to accept the port the host assigns and to bind every
# interface; a container is unreachable on loopback.
# NODE_ENV=production
#
# Which Core signs the invocation tokens this app accepts. The built-in default
# is the STAGING Core, which is wrong for anything deployed elsewhere: JWKS is
# fetched from the wrong issuer and every request fails with a bare 401.
# SOTA_CORE_ORIGIN=https://api.v4.sotaagents.ai
